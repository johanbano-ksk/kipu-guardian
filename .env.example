LOG_LEVEL=INFO
AWS_REGION=us-east-1

# CloudFormation outputs required by the worker. Leave blank for local setup.
SQS_INPUT_QUEUE_URL=
SQS_IDEMPOTENCY_TABLE=
SQS_WAIT_TIME_SECONDS=20
SQS_VISIBILITY_TIMEOUT_SECONDS=120
SQS_MAX_MESSAGES=10
SQS_IDEMPOTENCY_TTL_HOURS=168
ALERT_OCCURRENCE_TTL_HOURS=720

EVENTBRIDGE_OUTPUT_BUS_NAME=
EVENTBRIDGE_OUTPUT_SOURCE=acceptance.reviewer
EVENTBRIDGE_OUTPUT_DETAIL_TYPE=Anomaly Validated v1

FILTER_POLICY_PATH=config/filter_policy.yaml

# Optional second-pass AI review. Keep OPENAI_API_KEY in a secret store in AWS.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_TIMEOUT_SECONDS=30

# Optional manual reviewer provider: openai (legacy) or gemini.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=45

# Guardian agent historical investigation (no dashboard or HTTP server required).
HISTORY_AWS_PROFILE=data-core
HISTORY_ATHENA_WORKGROUP=primary
HISTORY_APPROVED_STATUSES=APPROVED
HISTORY_DECLINED_STATUSES=DECLINED

# Guardian daily extraction invokes the existing Lambda; never assumes the worker role.
ALERTS_AWS_PROFILE=ia-dev-payments-intelligence
ALERTS_AWS_REGION=us-east-1
ALERTS_EXTRACTOR_FUNCTION=kipu-alert-reviewer-manual-extractor
# Optional existing shared key; when blank, read the function configuration via IAM.
AGENT_EXECUTION_KEY=
